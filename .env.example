# Quantum Market Scanner configuration template.
#
# Every MRD_ variable added by the fix plan is listed here with its default
# and a one-line description, grouped by area. Unset variables use the
# defaults shown. The app reads these from the process environment (your
# shell, the launcher, or a service manager); it does not load .env files
# by itself yet.

# --- Security (docs/SECURITY.md) -------------------------------------------
# Admin token for writes and sensitive reads from other devices. Empty means
# generate one on first start and store it in data/admin_token.txt.
MRD_ADMIN_TOKEN=
# Browser origins allowed by CORS, comma-separated. A same-origin page on
# this machine is always accepted.
MRD_CORS_ORIGINS=http://127.0.0.1:8001,http://localhost:8001
# Interface the launchers bind to. 0.0.0.0 (or --lan) lets other devices on
# your network connect.
MRD_BIND_HOST=127.0.0.1
# 1 (or --tunnel) makes the launchers open a public Cloudflare Quick Tunnel.
MRD_TUNNEL=0
# 1 lets the backend open its own tunnel at startup when the launcher has
# not. The launchers set this from --tunnel.
MRD_AUTO_TUNNEL_ON_STARTUP=0
# 1 mounts /system/threads and /system/threads/summary (live thread stacks).
MRD_ENABLE_DEBUG_ROUTES=0
# 1 mounts /download/source.zip and /api/download/source/*.
MRD_ENABLE_SOURCE_DOWNLOAD=0

# --- Providers: CBOE options chains ----------------------------------------
# Chain URL template; must contain {symbol}. cdn.cboe.com now answers 307 to
# this host. Redirects are followed only within .cboe.com.
MRD_CBOE_BASE_URL=https://cdn-api.cboe.com/api/global/delayed_quotes/options/{symbol}.json
# Most chain downloads per rolling minute (about 1.5 MB each). Over the cap,
# chains fall back to Yahoo. Values below 1 fall back to 20.
MRD_CBOE_MAX_FETCHES_PER_MINUTE=20

# --- Providers: Stooq ------------------------------------------------------
# 1 adds Stooq daily CSVs to the stock quote cascade, last in line. Off by
# default: since March 2026 Stooq needs an API key, many networks can't
# reach it, and the daily quota per key is not published. It also needs a
# key, saved in the dashboard's Provider API keys panel or as STOOQ_API_KEY.
MRD_STOOQ_ENABLED=0
# STOOQ_API_KEY=
