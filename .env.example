# Quantum Market Scanner configuration template.
#
# Every MRD_ variable the app and its scripts read is listed here with its
# default and a one-line description, grouped by area (a unit test checks
# this). Unset variables use the defaults shown. The app reads these from
# the process environment (your shell, the launcher, or a service manager);
# it does not load .env files by itself yet.

# --- Security (docs/SECURITY.md) -------------------------------------------
# Admin token for writes and sensitive reads from other devices. Empty means
# generate one on first start and store it in data/admin_token.txt.
MRD_ADMIN_TOKEN=
# Browser origins allowed by CORS, comma-separated. A same-origin page on
# this machine is always accepted.
MRD_CORS_ORIGINS=http://127.0.0.1:8001,http://localhost:8001
# Interface the launchers bind to. 0.0.0.0 (or --lan) lets other devices on
# your network connect.
MRD_BIND_HOST=127.0.0.1
# 1 (or --tunnel) makes the launchers open a public Cloudflare Quick Tunnel.
MRD_TUNNEL=0
# 1 lets the backend open its own tunnel at startup when the launcher has
# not. The launchers set this from --tunnel.
MRD_AUTO_TUNNEL_ON_STARTUP=0
# 1 mounts /system/threads and /system/threads/summary (live thread stacks).
MRD_ENABLE_DEBUG_ROUTES=0
# 1 mounts /download/source.zip and /api/download/source/*.
MRD_ENABLE_SOURCE_DOWNLOAD=0

# --- Providers: CBOE options chains ----------------------------------------
# Chain URL template; must contain {symbol}. cdn.cboe.com now answers 307 to
# this host. Redirects are followed only within .cboe.com.
MRD_CBOE_BASE_URL=https://cdn-api.cboe.com/api/global/delayed_quotes/options/{symbol}.json
# Most chain downloads per rolling minute (about 1.5 MB each). Over the cap,
# chains fall back to Yahoo. Values below 1 fall back to 20.
MRD_CBOE_MAX_FETCHES_PER_MINUTE=20

# --- Providers: Stooq ------------------------------------------------------
# 1 adds Stooq daily CSVs to the stock quote cascade, last in line. Off by
# default: since March 2026 Stooq needs an API key, many networks can't
# reach it, and the daily quota per key is not published. It also needs a
# key, saved in the dashboard's Provider API keys panel or as STOOQ_API_KEY.
MRD_STOOQ_ENABLED=0
# STOOQ_API_KEY=

# --- yfinance downloads (Phase 4) ------------------------------------------
# Worker threads per yf.download call. Values below 1 count as 1.
MRD_YF_DOWNLOAD_THREADS=4
# yf.download calls allowed at once, process-wide. A caller waits up to 5 s
# for its turn, then the quote cascade moves on to the next provider.
MRD_YF_MAX_CONCURRENT_DOWNLOADS=1

# --- Thread alarm (Phase 4) ------------------------------------------------
# Python thread count above which the wedge watchdog logs a WARNING; over
# twice this it logs an ERROR with the most common thread-name prefixes.
# /system/status shows the count, the prefixes and the alarm level.
MRD_THREAD_ALARM=400

# --- Quotes and the detail panel -------------------------------------------
# Seconds a cached quote is reused by the detail panel's live tick (every
# 2 s) instead of a new provider lookup. 0 turns reuse off.
MRD_DETAIL_QUOTE_REUSE_SECONDS=5

# --- Prediction tracker -----------------------------------------------------
# Database file. Unset means data/saved_predictions.db.
# MRD_PREDICTIONS_DB=
# A prediction is a magnitude hit when the close lands within this many
# percent of its target price.
MRD_PREDICTION_MAGNITUDE_TOLERANCE_PCT=2.0

# --- Startup ----------------------------------------------------------------
# 0 keeps the prediction evaluator thread from starting (the test suite
# sets this).
MRD_START_BACKGROUND=1
# 1 stops startup when an optional router fails to mount, instead of
# recording it under mount_errors in /system/status.
MRD_STRICT_MOUNT=0
# File to read the public tunnel URL from, checked before
# app/data/public_url.txt and data/public_url.txt. Unset skips it.
# MRD_PUBLIC_URL_FILE=
# With MRD_AUTO_TUNNEL_ON_STARTUP=1, seconds the backend waits for the
# launcher's tunnel URL before opening its own tunnel.
MRD_TUNNEL_GRACE_SECONDS=18
# At startup, a public_url.txt older than this many seconds is cleared as
# left over from an earlier run.
MRD_TUNNEL_STALE_SECONDS=300

# --- Scanner tuning (settings that predate the fix plan) -------------------
# Percent of each batch, by first-pass score, re-scored at full depth
# (extended factors, options). Active-pool and regulatory rows always are.
MRD_FULL_SCORE_TOP_PCT=30
# 0 scores every row at full depth in a single pass.
MRD_TWO_PASS_SCORING=1
# Top rows per batch, by first-pass score, that always get a live options
# chain.
MRD_FORCED_OPTIONS_PER_BATCH=5
# Minimum seconds between active scan pool refreshes.
MRD_ACTIVE_POOL_REFRESH_SECONDS=10
# Worker threads for the options-chain prefetch.
MRD_OPTIONS_PREFETCH_WORKERS=6
# Seconds the options-chain prefetch waits before returning; unfinished
# fetches keep running in the background.
MRD_OPTIONS_PREFETCH_TIMEOUT=8
# Seconds the regulatory autoscan gives each ticker before moving on
# (at least 5).
MRD_AUTOSCAN_TICKER_TIMEOUT_S=30
